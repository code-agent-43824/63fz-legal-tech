# Application
NODE_ENV=development
# Base path is baked into the build (Next.js basePath + admin links + cookie path).
# Change it only together with a rebuild. Empty value or "/" serves the app from the root.
NEXT_PUBLIC_BASE_PATH=/63fz

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5439/63fz_legal_tech

# Admin
ADMIN_PASSWORD=change-me
AUTH_SECRET=change-me-at-least-32-characters
