{
  "name": "63fz-legal-tech",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "tsx --test tests/**/*.test.ts",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "security:audit": "pnpm audit --prod",
    "law:import:63fz": "tsx scripts/import-63fz.ts",
    "law:monitor:63fz": "node --no-warnings --experimental-strip-types scripts/monitor-63fz-amendments.ts",
    "law:export:markdown": "tsx scripts/export-63fz-markdown.ts",
    "law:import:drafts": "tsx scripts/import-editorial-drafts.ts",
    "db:ops:check": "tsx scripts/check-database-operations.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "DATABASE_URL=postgresql://postgres:postgres@localhost:5439/63fz_legal_tech prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "^16.2.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.11",
    "node-html-parser": "^7.1.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  }
}
